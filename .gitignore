# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

#claude
/.agents
/.claude/*
!/.claude/agents/
!/.claude/skills/
skills-lock.json

# paddle cli
/cli

# clerk configuration (can include secrets)
/.clerk/

# Playwright MCP browser artifacts (screenshots, snapshots, console logs)
.playwright-mcp/

# Playwright CLI artifacts — may capture filled form values (incl. credentials)
/test-results/
/playwright-report/
/e2e/.auth/
# run-gallurio driver screenshots (may capture seeded data)
/.driver-shots/
/e2e/.artifacts/
*.log
/.swc
