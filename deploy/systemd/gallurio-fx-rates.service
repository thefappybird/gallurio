[Unit]
Description=Gallurio: fetch daily FX reference rate table
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Root-readable only (chmod 600, chown root:root) — holds CRON_SECRET.
EnvironmentFile=/etc/gallurio/cron.env
# --fail: non-2xx exits non-zero so systemd marks the unit failed.
# --max-time 30: one Open Exchange Rates call (3s internal timeout) plus a
# Mongo upsert — 30s is generous headroom, not a target.
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 30 \
  -H "Authorization: Bearer ${CRON_SECRET}" \
  "${APP_ORIGIN}/api/cron/fx-rates"

# Alert hook: point OnFailure at a notify unit once one exists, e.g.
#   OnFailure=gallurio-cron-alert@%n.service
# A bare failed unit is otherwise silent — `systemctl --failed` only surfaces
# it if someone looks. A missed/failed run here is not urgent on its own:
# lib/pricing/fxRates.ts still serves the last stored table indefinitely, so
# this alert can queue behind higher-priority ones.
