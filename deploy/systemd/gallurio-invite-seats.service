[Unit]
Description=Gallurio: release expired invite seats (hourly sweep)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Root-readable only (chmod 600, chown root:root) — holds CRON_SECRET.
EnvironmentFile=/etc/gallurio/cron.env
# --fail: non-2xx exits non-zero so systemd marks the unit failed.
# --max-time 30: hard timeout — never let a stuck route hang the timer.
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 30 \
  -H "Authorization: Bearer ${CRON_SECRET}" \
  "${APP_ORIGIN}/api/cron/release-expired-invite-seats"

# Alert hook: point OnFailure at a notify unit once one exists, e.g.
#   OnFailure=gallurio-cron-alert@%n.service
# A bare failed unit is otherwise silent — `systemctl --failed` only surfaces
# it if someone looks.
