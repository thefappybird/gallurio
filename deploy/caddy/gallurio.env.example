# Non-secret Caddy configuration. Copy to /etc/caddy/gallurio.env and replace
# these placeholders before validating/reloading Caddy.
CADDY_EMAIL=support@gallurio.com
GALLURIO_CANONICAL_HOST=gallurio.com
GALLURIO_REDIRECT_HOST=www.gallurio.com

# Tenant public-page subdomains (*.gallurio.com). GALLURIO_WILDCARD_HOST is the
# Caddy site-block address; GALLURIO_ORIGIN_CERT/_KEY are filesystem paths to a
# Cloudflare Origin CA certificate + key (not the values themselves — Caddy
# reads them off disk). See deploy/README.md for issuance + install steps.
GALLURIO_WILDCARD_HOST=*.gallurio.com
GALLURIO_ORIGIN_CERT=/etc/caddy/certs/gallurio-origin.pem
GALLURIO_ORIGIN_KEY=/etc/caddy/certs/gallurio-origin-key.pem
