# -----------------------------------------------------------------------------
# Gallurio environment variables
# Copy this file to .env.local for local development.
# Never commit .env.local — it's gitignored.
# -----------------------------------------------------------------------------

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Gallurio
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set in production to serve portfolios as slug.<domain> (e.g. acme.gallurio.com);
# leave empty in dev to use /w/slug path-based URLs instead.
# NEXT_PUBLIC_PORTFOLIO_BASE_DOMAIN=gallurio.com

# --- MongoDB Atlas -----------------------------------------------------------
# Get this from Atlas: Connect -> Drivers -> Node.js
# Free M0 cluster is fine for development.
DATABASE_URL=

# --- Clerk auth --------------------------------------------------------------
# Create a free Clerk app at https://dashboard.clerk.com
# Enable: Email/Password + Google OAuth
# Enable: Organizations (Configure -> Organizations -> Enable)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Webhook secret from Clerk dashboard -> Webhooks -> Endpoints
CLERK_WEBHOOK_SECRET=

# Route overrides — match the file paths under app/(auth)/
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# --- Cloudinary (image storage) ----------------------------------------------
# Sign up free at https://cloudinary.com — Dashboard -> Account Details.
# The cloud name is ALSO needed publicly (for transformed thumbnail URLs in <img>).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_URL=

# --- HitPay (subscription billing) -------------------------------------------
# Sign up for a sandbox account at https://dashboard.sandbox.hit-pay.com
# (sandbox and live accounts are fully isolated — use a fresh email).
#
# Both values live under: Settings -> Payment Gateway -> API Keys
#   - HITPAY_API_KEY: the secret API key (sent as X-BUSINESS-API-KEY header)
#   - HITPAY_WEBHOOK_SALT: the "salt" used to verify webhook HMAC-SHA256
#
# To promote to production, swap ONLY these three vars — no code change:
#   HITPAY_API_KEY, HITPAY_WEBHOOK_SALT, HITPAY_API_BASE
HITPAY_API_KEY=
HITPAY_WEBHOOK_SALT=
HITPAY_API_BASE=https://api.sandbox.hit-pay.com
# Production base URL: https://api.hit-pay.com
#
# Pricing is defined in code (lib/hitpay/plans.ts) — no plan IDs to configure.
# Subscription billing uses card only (Visa/Mastercard) — HitPay does not
# support GCash for recurring; GCash is for end-client one-off payments only.

# --- WorkOS webhooks ---------------------------------------------------------
# Secret from the WorkOS dashboard -> Webhooks -> Endpoints -> Signing secret.
# Used to verify the HMAC-SHA256 signature on incoming webhook payloads.
WORKOS_WEBHOOK_SECRET=

# --- Future (placeholders — uncomment when wiring in later weeks) -----------
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=onboarding@resend.dev
#
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
#
# SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
#
# --- Figma (design generation) -----------------------------------------------
# Personal access token from figma.com -> Settings -> Security -> Personal access tokens
# FIGMA_ACCESS_TOKEN=figd_xxx
