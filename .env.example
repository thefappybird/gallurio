# -----------------------------------------------------------------------------
# Gallurio environment variables
# Copy this file to .env.local for local development.
# Never commit .env.local — it's gitignored.
#
# lib/env.ts fail-fast-validates this matrix. When NODE_ENV=production, a
# missing/invalid required var throws at server boot; in development/test it
# only logs a warning. See lib/env.ts for the full required-var list and the
# prod-only cross-checks (CLOUDFLARE_IMAGES_ACCOUNT_HASH must equal
# NEXT_PUBLIC_CF_IMAGES_ACCOUNT_HASH; LEMONSQUEEZY_TEST_MODE must be the
# literal "false"; AUTHKIT_DEBUG / SEED_OWNER_* / SEED_PORTFOLIO_SLUG /
# LEMONSQUEEZY_SIM_URL must NOT be set in production).
# -----------------------------------------------------------------------------

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Gallurio
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set in production to serve portfolios as slug.<domain> (e.g. acme.gallurio.com);
# leave empty in dev to use /w/slug path-based URLs instead.
# NEXT_PUBLIC_PORTFOLIO_BASE_DOMAIN=gallurio.com

# --- MongoDB Atlas -----------------------------------------------------------
# Get this from Atlas: Connect -> Drivers -> Node.js
# Free M0 cluster is fine for development.
DATABASE_URL=

# --- WorkOS AuthKit (identity only — Organizations are NOT used) -------------
# Create a WorkOS project at https://dashboard.workos.com, enable AuthKit +
# Google OAuth (Authentication -> Google OAuth).
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# >=32 chars, used by @workos-inc/authkit-nextjs to encrypt the session cookie.
WORKOS_COOKIE_PASSWORD=
# Match the callback route: app/api/auth/callback/route.ts
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Separate HMAC secret for the active-workspace cookie (lib/auth/activeWorkspace.ts).
ACTIVE_WORKSPACE_COOKIE_SECRET=
# Signing secret from WorkOS Dashboard -> Webhooks -> Endpoints. Verifies the
# email_verification.created webhook used to send our branded verification email.
WORKOS_WEBHOOK_SECRET=

# --- Cloudflare Turnstile (bot check) -----------------------------------------
# Required in production — sign-in/sign-up/forgot-password and the public
# inquiry form all gate submission on a verified token. In local dev
# (NODE_ENV=development) the widget auto-bypasses, so these can stay empty.
# Create a site at https://dash.cloudflare.com -> Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Cloudflare Images (direct creator upload) --------------------------------
# Cloudflare dashboard -> Images -> API keys/tokens.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGES_API_TOKEN=
CLOUDFLARE_IMAGES_ACCOUNT_HASH=
# Same value as CLOUDFLARE_IMAGES_ACCOUNT_HASH — needed publicly to build
# imagedelivery.net URLs client-side.
NEXT_PUBLIC_CF_IMAGES_ACCOUNT_HASH=

# --- Lemon Squeezy (subscription billing) -------------------------------------
# Create a store at https://app.lemonsqueezy.com, enable Test Mode, create the
# Pro product with monthly + yearly variants, generate an API key (Settings ->
# API), and register a webhook (Settings -> Webhooks) with a signing secret.
# See docs/lemonsqueezy-integration/lemonsqueezy-setup.md for the full walkthrough.
#
#   - LEMONSQUEEZY_API_KEY: Settings -> API -> create key
#   - LEMONSQUEEZY_STORE_ID: Settings -> General (numeric store id)
#   - LEMONSQUEEZY_WEBHOOK_SECRET: the signing secret set when creating the webhook
#   - LEMONSQUEEZY_VARIANT_PRO_MONTHLY_ID / LEMONSQUEEZY_VARIANT_PRO_YEARLY_ID:
#     the Pro product's monthly/yearly variant ids
#   - LEMONSQUEEZY_TEST_MODE: "true" in sandbox/beta, "false" at real launch
#     (defaults to test mode when unset — err toward sandbox)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_PRO_MONTHLY_ID=
LEMONSQUEEZY_VARIANT_PRO_YEARLY_ID=
LEMONSQUEEZY_TEST_MODE=true
#
# No NEXT_PUBLIC_* client key is needed — the checkout overlay (lemon.js) loads
# a server-generated checkout URL from the server.

# --- Email (Resend) ------------------------------------------------------------
# Sign up at https://resend.com -> API Keys. Verify a sending domain before
# production (the dev default only delivers to the Resend account owner).
# Both RESEND_API_KEY and EMAIL_FROM are required in production; lib/env.ts
# also rejects the onboarding@resend.dev default for EMAIL_FROM in production.
RESEND_API_KEY=re_xxx
EMAIL_FROM=Gallurio <onboarding@resend.dev>
# Optional global reply-to override; each notification defaults its reply-to
# to the inquiring client's email when unset.
# EMAIL_REPLY_TO=
#
# Optional — signing secret for Resend's async delivery-outcome webhook
# (Resend dashboard -> Webhooks -> Endpoints), format whsec_XXXXXXXX. Verifies
# app/api/webhooks/resend/route.ts (bounce/complaint monitoring only; unset in
# dev accepts unsigned posts). Not launch-blocking, so it's not required in
# production the way WORKOS_WEBHOOK_SECRET / LEMONSQUEEZY_WEBHOOK_SECRET are.
# RESEND_WEBHOOK_SECRET=

# --- Cron auth -----------------------------------------------------------------
# Bearer token required by app/api/cron/release-expired-invite-seats. On
# Vercel this is injected automatically for scheduled invocations; on Hetzner
# it must be supplied by the crontab entry that hits the endpoint (see
# docs/RELEASE-CHECKLIST.md).
CRON_SECRET=

# --- Dev seed accounts -------------------------------------------------------
# These accounts must already exist in WorkOS so the dev seed can attach real
# sign-in identities to the seeded demo workspaces.
SEED_OWNER_WORKOS_USER_ID=
SEED_OWNER_EMAIL=
SEED_OWNER_NAME=
SEED_OWNER_PASSWORD=
SUB_EXPIRED_WORKOS_USER_ID=
SUB_EXPIRED_WORKOS_EMAIL=
SUB_EXPIRED_WORKOS_NAME=
SUB_EXPIRED_WORKOS_PASSWORD=

# --- Beta tester program -----------------------------------------------------
# Set to "true" to surface the beta-tester activation chip on the onboarding
# plan step. Independent of NODE_ENV so it can be flipped on in any
# environment (including production, for real beta testers) and removed
# again just by unsetting this var. Leave unset/false otherwise.
#
# Enabled while MoR verification is pending (see docs/RELEASE-CHECKLIST.md):
# Pro checkout is hidden behind a "coming soon" overlay and beta activation is
# the live access path. Revert to unset/false once a MoR clears verification.
BETA_TESTER_ENABLED=true

# --- Social links (contact page) ---------------------------------------------
# Optional. Each icon on the contact page only renders when its URL is set —
# leave unset/empty to hide it until a real link is ready.
# NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=
# NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=
# NEXT_PUBLIC_SOCIAL_REDDIT_URL=
# NEXT_PUBLIC_SOCIAL_LINKEDIN_URL=

# --- Future (placeholders — uncomment when wiring in later weeks) -----------
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
#
# SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
#
# --- Figma (design generation) -----------------------------------------------
# Personal access token from figma.com -> Settings -> Security -> Personal access tokens
# FIGMA_ACCESS_TOKEN=figd_xxx
