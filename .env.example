# -----------------------------------------------------------------------------
# Gallurio environment variables
# Copy this file to .env.local for local development.
# Never commit .env.local — it's gitignored.
# -----------------------------------------------------------------------------

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Gallurio
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set in production to serve portfolios as slug.<domain> (e.g. acme.gallurio.com);
# leave empty in dev to use /w/slug path-based URLs instead.
# NEXT_PUBLIC_PORTFOLIO_BASE_DOMAIN=gallurio.com

# --- MongoDB Atlas -----------------------------------------------------------
# Get this from Atlas: Connect -> Drivers -> Node.js
# Free M0 cluster is fine for development.
DATABASE_URL=

# --- Clerk auth --------------------------------------------------------------
# Create a free Clerk app at https://dashboard.clerk.com
# Enable: Email/Password + Google OAuth
# Enable: Organizations (Configure -> Organizations -> Enable)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Webhook secret from Clerk dashboard -> Webhooks -> Endpoints
CLERK_WEBHOOK_SECRET=

# Route overrides — match the file paths under app/(auth)/
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# --- Cloudinary (image storage) ----------------------------------------------
# Sign up free at https://cloudinary.com — Dashboard -> Account Details.
# The cloud name is ALSO needed publicly (for transformed thumbnail URLs in <img>).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_URL=

# --- Lemon Squeezy (subscription billing) -------------------------------------
# Create a store at https://app.lemonsqueezy.com, enable Test Mode, create the
# Pro product with monthly + yearly variants, generate an API key (Settings ->
# API), and register a webhook (Settings -> Webhooks) with a signing secret.
# See docs/lemonsqueezy-integration/lemonsqueezy-setup.md for the full walkthrough.
#
#   - LEMONSQUEEZY_API_KEY: Settings -> API -> create key
#   - LEMONSQUEEZY_STORE_ID: Settings -> General (numeric store id)
#   - LEMONSQUEEZY_WEBHOOK_SECRET: the signing secret set when creating the webhook
#   - LEMONSQUEEZY_VARIANT_PRO_MONTHLY_ID / LEMONSQUEEZY_VARIANT_PRO_YEARLY_ID:
#     the Pro product's monthly/yearly variant ids
#   - LEMONSQUEEZY_TEST_MODE: "true" in sandbox/beta, "false" at real launch
#     (defaults to test mode when unset — err toward sandbox)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_PRO_MONTHLY_ID=
LEMONSQUEEZY_VARIANT_PRO_YEARLY_ID=
LEMONSQUEEZY_TEST_MODE=true
#
# No NEXT_PUBLIC_* client key is needed — the checkout overlay (lemon.js) loads
# a server-generated checkout URL, unlike Paddle's client-side token model.

# --- WorkOS webhooks ---------------------------------------------------------
# Secret from the WorkOS dashboard -> Webhooks -> Endpoints -> Signing secret.
# Used to verify the HMAC-SHA256 signature on incoming webhook payloads.
WORKOS_WEBHOOK_SECRET=

# --- Beta tester program -----------------------------------------------------
# Set to "true" to surface the beta-tester activation chip on the onboarding
# plan step. Independent of NODE_ENV so it can be flipped on in any
# environment (including production, for real beta testers) and removed
# again just by unsetting this var. Leave unset/false otherwise.
# BETA_TESTER_ENABLED=true

# --- Future (placeholders — uncomment when wiring in later weeks) -----------
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=onboarding@resend.dev
#
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
#
# SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
#
# --- Figma (design generation) -----------------------------------------------
# Personal access token from figma.com -> Settings -> Security -> Personal access tokens
# FIGMA_ACCESS_TOKEN=figd_xxx
